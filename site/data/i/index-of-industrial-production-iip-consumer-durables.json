,[1685577600,-6.78],[1688169600,-3.62],[1690848000,6.02],[1693526400,0.97],[1696118400,15.93],[1698796800,-4.83],[1701388800,5.24],[1704067200,11.58],[1706745600,12.56],[1709251200,9.53],[1711929600,10.63],[1714521600,11.54],[1717200000,11.03],[1719792000,10.55],[1722470400,7.04],[1725148800,10.9],[1727740800,8.35],[1730419200,8.58],[1733011200,8.65],[1735689600,7.85],[1738368000,1.25],[1740787200,5.25],[1743465600,5.18],[1746057600,1.91],[1748736000,1.37],[1751328000,3.89],[1754006400,0.87],[1756684800,4.58],[1759276800,-5.98],[1761955200,13.05],[1764547200,7.41],[1767225600,-0.25],[1769904000,4.23],[1772323200,2.41],[1775001600,5.64],[1777593600,8.01],[1780272000,10.25],[1782864000,11.99],[1785542400,10.47],[1788220800,5.97]]}]}],"qna":[{"question":"What does Consumer Durables data represent?","answer":"Consumer Durables data refers to the production of durable goods in the industrial sector, which reflects the demand for these products in the economy.^Consumer durables include household and personal items intended for long-term use, such as appliances, electronics, furniture, and vehicles. These are goods that do not need to be purchased very often and last for at least two/three years."},{"question":"What is the significance of Consumer Durables data?","answer":"This data serves as a barometer of consumption trends and spending power of people in the economy.^It helps in assessing the performance and growth prospects of the consumer goods sector, which is a significant component of the industrial sector.^This data provides insights for businesses and policymakers in understanding consumer behaviour, economic trends, and for planning marketing and investment strategies."},{"question":"How to interpret the Consumer Durables data?","answer":"High production and sales of consumer durables usually indicate healthy consumer sentiment, increased consumer spending, disposable income and a robust economy, as these goods are often purchased during periods of financial stability. In contrast, a decline may suggest economic challenges or shifts in consumer preferences due to loss of income.^Trends in consumer durables help to understand the impact of economic policies (such as taxation and import-export regulations), monetary policies (such as interest rates and liquidity), and other broader economic conditions (such as inflation and availability of credit).^Analysing the data across different categories of consumer durables can reveal trends in specific markets and consumer preferences, aiding in targeted business strategies."}],"related":[{"slug":"bank-credit-industry","title":"Bank Credit - Industry"},{"slug":"capacity-utilisation","title":"Capacity Utilisation"},{"slug":"cement-production","title":"Cement Production"},{"slug":"energy-requirements","title":"Energy Requirements"},{"slug":"exports-manufactured-goods","title":"Exports - Manufactured Goods"},{"slug":"hsbc-manufacturing-purchasing-managers-index-pmi","title":"HSBC Manufacturing PMI"},{"slug":"index-of-industrial-production-iip-consumer-non-durables","title":"Index of Industrial Production (IIP)- Consumer Non-Durables"},{"slug":"index-of-industrial-production-iip-electricity","title":"Index of Industrial Production (IIP)- Electricity"},{"slug":"index-of-industrial-production-iip-manufacturing","title":"Index of Industrial Production (IIP)- Manufacturing"},{"slug":"index-of-industrial-production-iip-mining","title":"Index of Industrial Production (IIP)- Mining"},{"slug":"natural-gas-production","title":"Natural Gas Production"},{"slug":"petroleum-consumption","title":"Petroleum Consumption"},{"slug":"steel-production","title":"Steel Production"},{"slug":"wholesale-price-index-wpi-inflation-manufacturing","title":"Wholesale Price Index (WPI) Inflation - Manufacturing"}],"title":"Index of Industrial Production (IIP)- Consumer Durables","description":"Consumer durables IIP stands at 133.1 for Sep 2026. This is a direct monthly read on discretionary spending, since durables are easier to postpone.","headline":{"Absolute":"Consumer durables IIP stands at 133.1 for Sep 2026. This is a direct monthly read on discretionary spending, since durables are easier to postpone.","Y-o-Y":"Consumer durables IIP stands at 5.97% for Sep 2026. This is a direct monthly read on discretionary spending, since durables are easier to postpone."},"source":null,"source_url":null,"date_modified":"2026-09-01","scraped_at":"2026-10-30T06:10:03+00:00"}